{
  "$description": "K League Transfer Radar design tokens (parcel-tracking screen). Mirrors tokens.css; keep both in sync.",
  "color": {
    "light": {
      "canvas": "#f4f5f7", "surface": "#ffffff", "ink": "#121823", "ink2": "#434c5c", "muted": "#6a7384", "line": "#dfe2e8", "focus": "#1d5fbf",
      "stage": {
        "unknown": { "fg": "#5b6270", "bg": "#eef0f3" },
        "interest": { "fg": "#4f5f78", "bg": "#e9eef6" },
        "contact": { "fg": "#1d5fbf", "bg": "#e6effc" },
        "negotiation": { "fg": "#8a5a00", "bg": "#fdf2dc" },
        "near_agreement": { "fg": "#6a3fb8", "bg": "#f1ebfb" },
        "confirmed": { "fg": "#ffffff", "bg": "#157a3d", "$note": "official confirmation only" },
        "failed": { "fg": "#b42318", "bg": "#fdecea" }
      },
      "review": { "pending": "#8a5a00", "refuted": "#b42318" }
    },
    "dark": {
      "canvas": "#0c0f14", "surface": "#151a22", "ink": "#e9edf3", "ink2": "#c0c7d2", "muted": "#8f99a9", "line": "#252c38", "focus": "#8cb8ff",
      "stage": {
        "unknown": { "fg": "#b4bac6", "bg": "#262a31" },
        "interest": { "fg": "#b3c0d6", "bg": "#222a36" },
        "contact": { "fg": "#8cb8ff", "bg": "#15243d" },
        "negotiation": { "fg": "#f2c46b", "bg": "#33270f" },
        "near_agreement": { "fg": "#c9adff", "bg": "#2a2140" },
        "confirmed": { "fg": "#06210f", "bg": "#4cc77f", "$note": "official confirmation only" },
        "failed": { "fg": "#ff9c92", "bg": "#3a1a17" }
      },
      "review": { "pending": "#f2c46b", "refuted": "#ff9c92" }
    }
  },
  "font": {
    "family": "Pretendard Variable, Pretendard, -apple-system, Apple SD Gothic Neo, Malgun Gothic, system-ui, sans-serif",
    "size": { "title": 22, "name": 15, "body": 14, "meta": 12, "label": 11 },
    "weight": { "regular": 400, "bold": 700, "heavy": 800 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24 },
  "radius": { "section": 16, "panel": 16, "chip": 18, "pill": 999 },
  "track": {
    "height": 34, "lineTopRatio": 0.64,
    "lineWidth": { "low": 3, "medium": 5, "high": 7 },
    "station": 12, "stationNow": 20, "stationNowHalo": 7, "ghost": 22,
    "stations": ["interest", "contact", "negotiation", "near_agreement", "confirmed"],
    "failedBreakAt": 0.56, "ghostFailedAt": 0.92
  },
  "motion": { "fast": 150, "base": 200, "ghostPulse": 2200, "reducedMotion": "disable all" }
}
